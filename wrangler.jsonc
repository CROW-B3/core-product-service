{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crow-core-product-service",
  "account_id": "8f0203259905d8923687286c84921e6c",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "local",
    "AI_GATEWAY_ID": "crow-ai-gateway",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AUTH_SERVICE_URL": "https://internal.auth-api.crowai.dev",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crow-core-product-service-db",
      "database_id": "f04c1d6d-60cf-4fe9-aed4-a2942bf0d11a",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "crow-core-product-service-store",
    },
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "crow-products" }],
  "queues": {
    "producers": [
      {
        "queue": "crow-product-crawl-queue",
        "binding": "PRODUCT_CRAWL_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "crow-product-crawl-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
      },
    ],
  },
  "routes": [
    { "pattern": "internal.products.crowai.dev", "custom_domain": true },
  ],
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "AI_GATEWAY_ID": "crow-ai-gateway",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "CRAWLER_SERVICE_URL": "https://infra-crawl-service-dev.bitbybit-b3.workers.dev",
        // CRAWLER_SERVICE_SECRET must be set as a secret: wrangler secret put CRAWLER_SERVICE_SECRET --env dev
        "AUTH_SERVICE_URL": "https://dev.internal.auth-api.crowai.dev",
      },
      "ai": {
        "binding": "AI",
      },
      "browser": {
        "binding": "BROWSER",
      },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "crow-products-dev" }],
      "routes": [
        {
          "pattern": "dev.internal.products.crowai.dev",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crow-core-product-service-db-dev",
          "database_id": "4d8e73e2-b069-46c4-96ad-ba2904112983",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "crow-core-product-service-store-dev",
        },
      ],
      "queues": {
        "producers": [
          {
            "queue": "crow-product-crawl-queue-dev",
            "binding": "PRODUCT_CRAWL_QUEUE",
          },
        ],
        "consumers": [
          {
            "queue": "crow-product-crawl-queue-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "retry_delay": 60,
          },
        ],
      },
    },
    "local": {
      "vars": {
        "ENVIRONMENT": "local",
        "AI_GATEWAY_ID": "crow-ai-gateway",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "CRAWLER_SERVICE_URL": "http://localhost:8014",
        "AUTH_SERVICE_URL": "http://localhost:8001"
        // BETTER_AUTH_SECRET: wrangler secret put BETTER_AUTH_SECRET --env local
        // CRAWLER_SERVICE_SECRET: wrangler secret put CRAWLER_SERVICE_SECRET --env local
      },
      "ai": {
        "binding": "AI",
        "remote": true,
      },
      "browser": {
        "binding": "BROWSER",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crow-core-product-service-db-local",
          "database_id": "28bfe4ff-4126-416b-a65e-bd9740184ff3",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "crow-core-product-service-store-local",
        },
      ],
      "queues": {
        "producers": [
          {
            "queue": "crow-product-crawl-queue-local",
            "binding": "PRODUCT_CRAWL_QUEUE",
          },
        ],
        "consumers": [
          {
            "queue": "crow-product-crawl-queue-local",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "retry_delay": 60,
          },
        ],
      },
    },
  },
}
